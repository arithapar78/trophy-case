# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# .env.local holds your real settings and is NEVER committed to git.
# This file (.env.example) is a template with no real secrets, so it IS committed.
#
# Nothing here is required. The app runs with no .env.local at all — every
# setting below already has a sensible default.

# --- Database location ---
# Where the SQLite database file lives. The default is fine; only change it
# if you want the database somewhere else.
DATABASE_URL="file:./prisma/dev.db"

# --- Photo location ---
# Where your photos are saved. Leave blank to use the project's own
# uploads/ folder, which is what you want for normal use.
UPLOADS_DIR=
