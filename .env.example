# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# .env.local holds your real settings and is NEVER committed to git.
# This file (.env.example) is a template with no real secrets, so it IS committed.

# --- Claude API key (optional) ---
# Used for the "Give me 3 college essay ideas" feature.
# Get one at https://console.anthropic.com -> API Keys.
#
# LEAVE THIS BLANK if you don't have a key. The app will run in MOCK mode
# and return clearly-labeled sample essay ideas so everything still works.
ANTHROPIC_API_KEY=

# --- Database location ---
# Where the SQLite database file lives. The default is fine; only change it
# if you want the database somewhere else.
DATABASE_URL="file:./prisma/dev.db"
