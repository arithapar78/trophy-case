# Settings for the LIVE site (the public one).
#
# Copy this to .env.production.local and fill it in:
#   cp .env.production.example .env.production.local
#
# .env.production.local is never committed. This example file is safe to commit
# because it has no real key in it.
#
# These only apply to the live site (npm run start:live). Your personal copy
# (npm run dev) ignores this file completely and keeps using its own data.

# --- Where the live site keeps its data ---
# Outside the project folder on purpose, so the live site and your personal
# copy can never mix. ~ is not expanded here, so write the full path.
DATABASE_URL="file:/Users/Ari/TrophyCaseLive/trophy-case.db"
UPLOADS_DIR="/Users/Ari/TrophyCaseLive/uploads"
BACKUPS_DIR="/Users/Ari/TrophyCaseLive/backups"

# --- Claude API key for the live site ---
# Use a SEPARATE key from your personal one, with a monthly spending limit set
# in the Anthropic Console. That way the live site can be switched off without
# touching your own copy, and a runaway cost is capped.
#
# Leave blank to run the live site in MOCK mode with no AI costs at all.
ANTHROPIC_API_KEY=

# --- Optional: override the site-wide daily prompt cap ---
# Defaults to 500. Lower it while testing if you want.
# AI_DAILY_CAP=500
