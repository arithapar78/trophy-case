// The shape of the database. After changing this file, run:
//   npm run db:push
//
// The database location lives in prisma.config.ts (Prisma 7 moved it out
// of this file).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// One saved win. See REQUIREMENTS.md for the field rules.
model Achievement {
  id       String   @id @default(cuid())
  title    String
  date     DateTime
  category String
  note     String?

  // The photo. Both are set together, or both are null.
  photoPath String? // file name inside the uploads folder, e.g. "abc123.jpg"
  photoType String? // MIME type, e.g. "image/jpeg"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Newest-first timeline ordering. createdAt breaks ties on the same date.
  @@index([date, createdAt])
  @@index([category])
}
